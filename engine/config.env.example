# AgentFLOW Engine Configuration
# Copy to config.env and customize as needed.

# Fuseki endpoint
FUSEKI_HOST="http://localhost:3030"
DATASET="agentflow"

# Named graph IRIs
DEFINITIONS_GRAPH="http://example.org/graphs/definitions"
RUNTIME_GRAPH="http://example.org/graphs/runtime"

# Derived URLs (no need to edit)
QUERY_URL="${FUSEKI_HOST}/${DATASET}/sparql"
UPDATE_URL="${FUSEKI_HOST}/${DATASET}/update"
GSP_URL="${FUSEKI_HOST}/${DATASET}/data"

# Goose CLI
GOOSE_CMD="goose"

# Gateway approval polling
APPROVAL_POLL_INTERVAL=5
APPROVAL_TIMEOUT_SECONDS=3600

# Logging
LOG_LEVEL="INFO"    # DEBUG | INFO | WARN | ERROR
