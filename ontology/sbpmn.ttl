@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sbpmn:  <http://example.org/ontology/sbpmn#> .
@prefix sbpmnc: <http://example.org/ontology/sbpmnc#> .

# ═══════════════════════════════════════════════════════════
# sBPMN Ontology — Minimal Viable Subset for AgentFLOW
#
# This is NOT the full sBPMN specification. It defines only
# the classes and properties that the AgentFLOW engine
# actually consumes. See docs/decisions.md for rationale.
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# Abstract Base Classes
# ───────────────────────────────────────────────────────────

sbpmnc:FlowNode a owl:Class ;
    rdfs:label "Flow Node" ;
    rdfs:comment "Abstract base class for all nodes in a process flow." .

sbpmnc:Event rdfs:subClassOf sbpmnc:FlowNode ;
    rdfs:label "Event" ;
    rdfs:comment "Abstract base class for process events." .

sbpmnc:Task rdfs:subClassOf sbpmnc:FlowNode ;
    rdfs:label "Task" ;
    rdfs:comment "Abstract base class for executable work units." .

sbpmnc:Gateway rdfs:subClassOf sbpmnc:FlowNode ;
    rdfs:label "Gateway" ;
    rdfs:comment "Abstract base class for routing decisions." .

# ───────────────────────────────────────────────────────────
# Concrete Event Types
# ───────────────────────────────────────────────────────────

sbpmnc:StartEvent rdfs:subClassOf sbpmnc:Event ;
    rdfs:label "Start Event" ;
    rdfs:comment "The entry point of a process." .

sbpmnc:EndEvent rdfs:subClassOf sbpmnc:Event ;
    rdfs:label "End Event" ;
    rdfs:comment "A terminal point of a process." .

# ───────────────────────────────────────────────────────────
# Concrete Task Types (defined for ontological completeness;
# AgentFLOW engine uses only agentflow:AgenticTask)
# ───────────────────────────────────────────────────────────

sbpmnc:UserTask rdfs:subClassOf sbpmnc:Task ;
    rdfs:label "User Task" .

sbpmnc:ScriptTask rdfs:subClassOf sbpmnc:Task ;
    rdfs:label "Script Task" .

sbpmnc:ServiceTask rdfs:subClassOf sbpmnc:Task ;
    rdfs:label "Service Task" .

sbpmnc:BusinessRuleTask rdfs:subClassOf sbpmnc:Task ;
    rdfs:label "Business Rule Task" .

sbpmnc:SendTask rdfs:subClassOf sbpmnc:Task ;
    rdfs:label "Send Task" .

sbpmnc:ReceiveTask rdfs:subClassOf sbpmnc:Task ;
    rdfs:label "Receive Task" .

sbpmnc:ManualTask rdfs:subClassOf sbpmnc:Task ;
    rdfs:label "Manual Task" .

# ───────────────────────────────────────────────────────────
# Concrete Gateway Types
# ───────────────────────────────────────────────────────────

sbpmnc:ExclusiveGateway rdfs:subClassOf sbpmnc:Gateway ;
    rdfs:label "Exclusive Gateway" ;
    rdfs:comment "XOR routing — exactly one outgoing path." .

sbpmnc:ParallelGateway rdfs:subClassOf sbpmnc:Gateway ;
    rdfs:label "Parallel Gateway" .

sbpmnc:InclusiveGateway rdfs:subClassOf sbpmnc:Gateway ;
    rdfs:label "Inclusive Gateway" .

sbpmnc:EventBasedGateway rdfs:subClassOf sbpmnc:Gateway ;
    rdfs:label "Event-Based Gateway" .

sbpmnc:ComplexGateway rdfs:subClassOf sbpmnc:Gateway ;
    rdfs:label "Complex Gateway" ;
    rdfs:comment "Custom activation semantics beyond standard gateway types." .

# ───────────────────────────────────────────────────────────
# Process Definition
# ───────────────────────────────────────────────────────────

sbpmn:ProcessDefinition a owl:Class ;
    rdfs:label "Process Definition" ;
    rdfs:comment "A workflow blueprint containing flow nodes and sequence flows." .

sbpmn:hasStartEvent a owl:ObjectProperty ;
    rdfs:domain sbpmn:ProcessDefinition ;
    rdfs:range sbpmnc:StartEvent .

sbpmn:hasEndEvent a owl:ObjectProperty ;
    rdfs:domain sbpmn:ProcessDefinition ;
    rdfs:range sbpmnc:EndEvent .

sbpmn:hasTask a owl:ObjectProperty ;
    rdfs:domain sbpmn:ProcessDefinition ;
    rdfs:range sbpmnc:Task .

# ───────────────────────────────────────────────────────────
# Sequence Flow (TBox — process topology)
# ───────────────────────────────────────────────────────────

sbpmn:nextTask a owl:ObjectProperty ;
    rdfs:domain sbpmnc:FlowNode ;
    rdfs:range sbpmnc:FlowNode ;
    rdfs:label "next task" ;
    rdfs:comment "Sequence flow connecting one node to the next. Gateway conditions are attached via Turtle-star annotations." .

# Properties used as Turtle-star annotations on sbpmn:nextTask edges
sbpmn:varName a owl:DatatypeProperty ;
    rdfs:label "variable name" ;
    rdfs:comment "Name of the ABox process variable to evaluate." .

sbpmn:operator a owl:DatatypeProperty ;
    rdfs:label "comparison operator" ;
    rdfs:comment "Comparison operator: >, >=, <, <=, ==" .

sbpmn:threshold a owl:DatatypeProperty ;
    rdfs:label "threshold value" ;
    rdfs:comment "Value to compare the variable against." .

sbpmn:isDefault a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "is default route" ;
    rdfs:comment "Marks a sequence flow as the default/fallback path." .

# ───────────────────────────────────────────────────────────
# Runtime Classes (ABox — process execution state)
# ───────────────────────────────────────────────────────────

sbpmn:ProcessInstance a owl:Class ;
    rdfs:label "Process Instance" ;
    rdfs:comment "A running instance of a ProcessDefinition." .

sbpmn:TaskInstance a owl:Class ;
    rdfs:label "Task Instance" ;
    rdfs:comment "A runtime execution record for a single task." .

sbpmn:ProcessVariable a owl:Class ;
    rdfs:label "Process Variable" ;
    rdfs:comment "A named variable holding runtime state for a process instance." .

# ───────────────────────────────────────────────────────────
# Runtime Properties (ABox)
# ───────────────────────────────────────────────────────────

sbpmn:instantiatesProcess a owl:ObjectProperty ;
    rdfs:domain sbpmn:ProcessInstance ;
    rdfs:range sbpmn:ProcessDefinition .

sbpmn:processStatus a owl:DatatypeProperty ;
    rdfs:domain sbpmn:ProcessInstance ;
    rdfs:range xsd:string ;
    rdfs:comment "RUNNING | COMPLETED | FAILED | ABORTED" .

sbpmn:currentTask a owl:ObjectProperty ;
    rdfs:domain sbpmn:ProcessInstance ;
    rdfs:range sbpmn:TaskInstance .

sbpmn:hasVariable a owl:ObjectProperty ;
    rdfs:domain sbpmn:ProcessInstance ;
    rdfs:range sbpmn:ProcessVariable .

sbpmn:instantiatesTask a owl:ObjectProperty ;
    rdfs:domain sbpmn:TaskInstance ;
    rdfs:range sbpmnc:FlowNode .

sbpmn:taskStatus a owl:DatatypeProperty ;
    rdfs:domain sbpmn:TaskInstance ;
    rdfs:range xsd:string ;
    rdfs:comment "PENDING | RUNNING | COMPLETED | FAILED" .

sbpmn:taskOutput a owl:DatatypeProperty ;
    rdfs:domain sbpmn:TaskInstance ;
    rdfs:range xsd:string ;
    rdfs:comment "JSON string containing the task execution output." .

sbpmn:startTime a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

sbpmn:endTime a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

# Variable properties
sbpmn:varValue a owl:DatatypeProperty ;
    rdfs:domain sbpmn:ProcessVariable ;
    rdfs:comment "The current value of a process variable." .

# Transition audit trail
sbpmn:followedBy a owl:ObjectProperty ;
    rdfs:domain sbpmn:TaskInstance ;
    rdfs:range sbpmn:TaskInstance ;
    rdfs:comment "Links completed task to next task. Turtle-star annotations carry audit metadata." .

sbpmn:transitionedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Timestamp of a task transition (Turtle-star annotation on followedBy)." .

sbpmn:triggeredBy a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "Identity of the engine/actor that triggered the transition." .

sbpmn:evaluatedVariable a owl:DatatypeProperty ;
    rdfs:comment "Variable name evaluated during gateway routing (audit)." .

sbpmn:evaluatedValue a owl:DatatypeProperty ;
    rdfs:comment "Variable value at time of gateway evaluation (audit)." .
