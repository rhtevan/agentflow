@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix cto:    <http://example.org/ontology/cto#> .
@prefix sbpmnc: <http://example.org/ontology/sbpmnc#> .

# ═══════════════════════════════════════════════════════════
# CTO — Common Telecommunications Ontology
# Minimal subset for AgentFLOW Demo 1 (SIM Activation)
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# Network Element Hierarchy
# ───────────────────────────────────────────────────────────

cto:NetworkElement a owl:Class ;
    rdfs:label "Network Element" ;
    rdfs:comment "A physical or logical component of a telecommunications network." .

cto:HomeLocationRegister rdfs:subClassOf cto:NetworkElement ;
    rdfs:label "Home Location Register (HLR)" ;
    rdfs:comment "A central database containing subscriber data for GSM/UMTS networks." .

# ───────────────────────────────────────────────────────────
# Network Element Properties
# ───────────────────────────────────────────────────────────

cto:elementId a owl:DatatypeProperty ;
    rdfs:domain cto:NetworkElement ;
    rdfs:range xsd:string ;
    rdfs:label "element ID" ;
    rdfs:comment "Unique identifier for the network element." .

cto:operationalStatus a owl:DatatypeProperty ;
    rdfs:domain cto:NetworkElement ;
    rdfs:range xsd:string ;
    rdfs:label "operational status" ;
    rdfs:comment "Current status: ACTIVE | MAINTENANCE | DECOMMISSIONED" .

cto:vendor a owl:DatatypeProperty ;
    rdfs:domain cto:NetworkElement ;
    rdfs:range xsd:string ;
    rdfs:label "vendor" .

cto:location a owl:DatatypeProperty ;
    rdfs:domain cto:NetworkElement ;
    rdfs:range xsd:string ;
    rdfs:label "location" .

# ───────────────────────────────────────────────────────────
# Task-to-Network Element Relationship
# ───────────────────────────────────────────────────────────

cto:targetsNetworkElement a owl:ObjectProperty ;
    rdfs:domain sbpmnc:Task ;
    rdfs:range cto:NetworkElement ;
    rdfs:label "targets network element" ;
    rdfs:comment "Links a task to the network element it operates on." .

# ───────────────────────────────────────────────────────────
# Turtle-star annotation properties
# (used on task-to-resource edges for runtime allocation)
# ───────────────────────────────────────────────────────────

cto:assignedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Timestamp when a resource was assigned to a task (Turtle-star annotation)." .
