# 02_show_active_token.rq
# Shows where the process token currently sits.
# Run this while the engine is paused (--pause mode) to see live state.

PREFIX sbpmn:     <https://sBPMN.github.io/2.0/properties#>
PREFIX sbpmnc:    <https://sBPMN.github.io/2.0/classes#>
PREFIX agentflow: <http://example.org/ontology/agentflow#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?process ?processStatus ?currentTaskInst ?taskDef ?taskLabel ?taskStatus ?nodeType WHERE {
  GRAPH <http://example.org/graphs/runtime> {
    ?process a agentflow:ProcessInstance ;
             agentflow:processStatus ?processStatus ;
             agentflow:currentTask ?currentTaskInst .
    ?currentTaskInst agentflow:instantiatesTask ?taskDef ;
                     agentflow:taskStatus ?taskStatus .
  }
  GRAPH <http://example.org/graphs/definitions> {
    ?taskDef a ?nodeType .
    OPTIONAL { ?taskDef rdfs:label ?taskLabel }
    FILTER (?nodeType NOT IN (owl:NamedIndividual, rdfs:Resource))
  }
}
