# 06_show_process_variables.rq
# Shows all process variables accumulated during execution.
# Run after each task to see how the ABox state grows.

PREFIX sbpmn: <https://sBPMN.github.io/2.0/properties#>

SELECT ?process ?varName ?varValue WHERE {
  GRAPH <http://example.org/graphs/runtime> {
    ?process a agentflow:ProcessInstance ;
             agentflow:hasVariable ?var .
    ?var agentflow:varName ?varName ;
         agentflow:varValue ?varValue .
  }
}
ORDER BY ?process ?varName
