@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix sbpmn:     <https://sBPMN.github.io/2.0/properties#> .
@prefix sbpmnc:    <https://sBPMN.github.io/2.0/classes#> .
@prefix agentflow: <http://example.org/ontology/agentflow#> .
@prefix ex:        <http://example.org/instances/> .

# ═══════════════════════════════════════════════════════════
# Demo 2: Git Push Safety — Process Definition (TBox)
#
# Linear preparation chain → single GuardrailGateway
# (human-in-the-loop) → push or abort
#
# Every push goes through human eyes. No auto-skip.
# ═══════════════════════════════════════════════════════════

# ── Process Definition ────────────────────────────────────

ex:ProcDef_GitPushSafety a agentflow:AgenticProcess ;
    rdfs:label "Git Push Safety Workflow" ;
    agentflow:engineVersion "0.1.0" ;
    agentflow:hasStartEvent ex:Start_GitPush ;
    agentflow:hasEndEvent ex:End_Completed, ex:End_Aborted .

# ── Start Event ───────────────────────────────────────────

ex:Start_GitPush a sbpmnc:startEvent ;
    rdfs:label "Git Push Initiated" ;
    agentflow:nextTask ex:Task_StageChanges .

# ── Task 1: Stage Changes ────────────────────────────────

ex:Task_StageChanges a agentflow:AgenticTask ;
    rdfs:label "Stage Changes" ;
    agentflow:recipe "git_stage" ;
    agentflow:nextTask ex:Task_ScanSecrets .

# ── Task 2: Scan Secrets ─────────────────────────────────

ex:Task_ScanSecrets a agentflow:AgenticTask ;
    rdfs:label "Scan for Secrets & PII" ;
    agentflow:recipe "git_scan_secrets" ;
    agentflow:nextTask ex:Task_GenerateReport .

# ── Task 3: Generate Report ──────────────────────────────

ex:Task_GenerateReport a agentflow:AgenticTask ;
    rdfs:label "Generate Pre-Push Security Report" ;
    agentflow:recipe "git_security_report" ;
    agentflow:nextTask ex:Task_ReadmeCheck .

# ── Task 4: README Check ─────────────────────────────────

ex:Task_ReadmeCheck a agentflow:AgenticTask ;
    rdfs:label "Check README Staleness" ;
    agentflow:recipe "git_readme_check" ;
    agentflow:nextTask ex:GW_HumanApproval .

# ── GuardrailGateway: Human Approval (ALWAYS BLOCKS) ────

ex:GW_HumanApproval a agentflow:GuardrailGateway ;
    rdfs:label "Human Push Approval" ;
    agentflow:requiresApproval true ;
    agentflow:approvalTimeout "PT1H"^^xsd:dayTimeDuration .

# Branch A: Human approves → push
ex:GW_HumanApproval agentflow:nextTask ex:Task_ExecutePush {|
    agentflow:varName   "approval_status" ;
    agentflow:operator  "==" ;
    agentflow:threshold "APPROVED" ;
    agentflow:isDefault false
|} .

# Branch B: Denied or timeout → abort
ex:GW_HumanApproval agentflow:nextTask ex:End_Aborted {|
    agentflow:isDefault true
|} .

# ── Task 5: Execute Push ─────────────────────────────────

ex:Task_ExecutePush a agentflow:AgenticTask ;
    rdfs:label "Execute Git Push" ;
    agentflow:recipe "git_push" ;
    agentflow:nextTask ex:Task_LogResult .

# ── Task 6: Log Result ───────────────────────────────────

ex:Task_LogResult a agentflow:AgenticTask ;
    rdfs:label "Log Push Result" ;
    agentflow:recipe "git_log_result" ;
    agentflow:nextTask ex:End_Completed .

# ── End Events ────────────────────────────────────────────

ex:End_Completed a sbpmnc:endEvent ;
    rdfs:label "Push Completed Successfully" .

ex:End_Aborted a sbpmnc:endEvent ;
    rdfs:label "Push Aborted" .
