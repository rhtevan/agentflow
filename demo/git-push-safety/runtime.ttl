@prefix sbpmn:     <http://example.org/ontology/sbpmn#> .
@prefix sbpmnc:    <http://example.org/ontology/sbpmnc#> .
@prefix agentflow: <http://example.org/ontology/agentflow#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:        <http://example.org/instances/> .

# ═══════════════════════════════════════════════════════════
# Demo 2: Git Push Safety — Initial Runtime State (ABox)
#
# Creates a process instance with the token at StartEvent.
# The Object Under Process is the local git working directory,
# referenced by path in the process variables.
# ═══════════════════════════════════════════════════════════

# ── Process Instance ──────────────────────────────────────

ex:ProcInst_GitPush_001 a sbpmn:ProcessInstance ;
    sbpmn:instantiatesProcess ex:ProcDef_GitPushSafety ;
    sbpmn:processStatus "RUNNING" ;
    sbpmn:currentTask ex:TaskInst_Start_GitPush ;
    sbpmn:hasVariable ex:Var_WorkDir, ex:Var_Remote, ex:Var_Branch .

# ── Initial Task Instance (at StartEvent) ─────────────────

ex:TaskInst_Start_GitPush a sbpmn:TaskInstance ;
    sbpmn:instantiatesTask ex:Start_GitPush ;
    sbpmn:taskStatus "RUNNING" ;
    sbpmn:startTime "2026-07-28T15:00:00Z"^^xsd:dateTime .

# ── Process Variables (Object Under Process: Git Repo) ────

ex:Var_WorkDir a sbpmn:ProcessVariable ;
    sbpmn:varName "work_dir" ;
    sbpmn:varValue "." .

ex:Var_Remote a sbpmn:ProcessVariable ;
    sbpmn:varName "remote" ;
    sbpmn:varValue "origin" .

ex:Var_Branch a sbpmn:ProcessVariable ;
    sbpmn:varName "branch" ;
    sbpmn:varValue "main" .
