@prefix sbpmn:     <https://sBPMN.github.io/2.0/properties#> .
@prefix sbpmnc:    <https://sBPMN.github.io/2.0/classes#> .
@prefix agentflow: <http://example.org/ontology/agentflow#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:        <http://example.org/instances/> .

# ═══════════════════════════════════════════════════════════
# Demo 2: Git Push Safety — Initial Runtime State (ABox)
#
# Creates a process instance with the token at StartEvent.
# The Object Under Process is the local git working directory,
# referenced by path in the process variables.
# ═══════════════════════════════════════════════════════════

# ── Process Instance ──────────────────────────────────────

ex:ProcInst_GitPush_001 a agentflow:ProcessInstance ;
    agentflow:instantiatesProcess ex:ProcDef_GitPushSafety ;
    agentflow:processStatus "RUNNING" ;
    agentflow:currentTask ex:TaskInst_Start_GitPush ;
    agentflow:hasVariable ex:Var_WorkDir, ex:Var_Remote, ex:Var_Branch .

# ── Initial Task Instance (at StartEvent) ─────────────────

ex:TaskInst_Start_GitPush a agentflow:TaskInstance ;
    agentflow:instantiatesTask ex:Start_GitPush ;
    agentflow:taskStatus "RUNNING" ;
    agentflow:startTime "2026-07-28T15:00:00Z"^^xsd:dateTime .

# ── Process Variables (Object Under Process: Git Repo) ────

ex:Var_WorkDir a agentflow:ProcessVariable ;
    agentflow:varName "work_dir" ;
    agentflow:varValue "." .

ex:Var_Remote a agentflow:ProcessVariable ;
    agentflow:varName "remote" ;
    agentflow:varValue "origin" .

ex:Var_Branch a agentflow:ProcessVariable ;
    agentflow:varName "branch" ;
    agentflow:varValue "main" .
